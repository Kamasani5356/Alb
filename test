resource "google_compute_url_map" "url_map" {
  count           = var.manage_url_map ? 1 : 0
  project         = var.project_id
  name            = local.url_map_name   # external-global-alb
  default_service = var.existing_default_service

  host_rule {
    hosts        = ["*"]
    path_matcher = "cdn"
  }

  path_matcher {
    name            = "cdn"
    default_service = var.existing_default_service

    path_rule {
      paths   = [var.cdn_path]
      service = google_compute_backend_bucket.backend.self_link
    }
  }

  lifecycle {
    prevent_destroy = true
  }
}

variable "existing_default_service" { type = string }
variable "cdn_path" {
  type    = string
  default = "/cdn/*"
}


existing_load_balancer_name = "external-global-alb"
existing_default_service    = "https://www.googleapis.com/compute/v1/projects/uc-sandbox-1/global/backendServices/<name>"

terraform import 'module.cloud_cdn.google_compute_url_map.url_map[0]' projects/uc-sandbox-1/global/urlMaps/external-global-alb
terraform plan
