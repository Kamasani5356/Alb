terraform {

  required_version = ">= 1.3.0"

  required_providers {

    google = {

      source  = "hashicorp/google"

      version = ">= 6.0"
    }
  }
}

# --------------------------------------------------
# Provider Configuration
# --------------------------------------------------

provider "google" {

  project = var.project_id

  region = var.region
}

# --------------------------------------------------
# Cloud CDN Module
# --------------------------------------------------

module "cloud_cdn" {

  source = "../"

  # Project Configuration

  project_id = var.project_id

  enable_apis = true

  region = var.region

  # Storage Configuration

  bucket_name = "my-demo-cloud-cdn-bucket-12345"

  bucket_location = "US"

  force_destroy = false

  uniform_bucket_level_access = true

  make_bucket_public = true

  bucket_labels = {

    environment = "sandbox"

    managed_by  = "terraform"
  }

  # Backend Configuration

  backend_bucket_name = "demo-cdn-backend"

  backend_bucket_description = "Sandbox Cloud CDN backend"

  enable_cdn = true

  compression_mode = "AUTOMATIC"

  # CDN Configuration

  cache_mode = "CACHE_ALL_STATIC"

  default_ttl = 3600

  max_ttl = 86400

  client_ttl = 3600

  negative_caching = true

  negative_caching_policy = [

    {
      code = 404

      ttl = 120
    },

    {
      code = 500

      ttl = 60
    }
  ]

  serve_while_stale = 86400

  signed_url_cache_max_age_sec = 3600

  request_coalescing = true

  cache_key_policy = {

    query_string_whitelist = [
      "version"
    ]

    include_http_headers = [
      "Accept"
    ]
  }

  bypass_cache_on_request_headers = [
    "Authorization"
  ]

  custom_response_headers = []

  edge_security_policy = null

  # URL Map

  url_map_name = "demo-cdn-url-map"

  url_map_description = "Sandbox CDN URL map"

  # Global IP

  global_ip_name = "demo-cdn-global-ip"

  ip_version = "IPV4"

  # HTTP Configuration

  enable_http = true

  http_proxy_name = "demo-cdn-http-proxy"

  http_forwarding_rule_name = "demo-cdn-http-forwarding"

  # HTTPS Configuration

  enable_https = false

  domain_names = []

  ssl_certificate_name = "demo-cdn-ssl"

  https_proxy_name = "demo-cdn-https-proxy"

  https_forwarding_rule_name = "demo-cdn-https-forwarding"

  # Load Balancer

  load_balancing_scheme = "EXTERNAL_MANAGED"

  network_tier = "PREMIUM"
}
