terraform {
  required_version = ">= 1.3.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 6.0"
    }
  }
}

# --------------------------------------------------
# Enable Required APIs
# --------------------------------------------------

resource "google_project_service" "required_apis" {

  for_each = var.enable_apis ? toset([
    "compute.googleapis.com",
    "storage.googleapis.com"
  ]) : toset([])

  project = var.project_id

  service = each.value

  disable_on_destroy = false
}

# --------------------------------------------------
# Cloud Storage Bucket
# --------------------------------------------------

resource "google_storage_bucket" "cdn_bucket" {

  project = var.project_id

  name = var.bucket_name

  location = var.bucket_location

  force_destroy = var.force_destroy

  uniform_bucket_level_access = var.uniform_bucket_level_access

  public_access_prevention = var.make_bucket_public ? "inherited" : "enforced"

  labels = var.bucket_labels

  depends_on = [
    google_project_service.required_apis
  ]
}

# --------------------------------------------------
# Cloud Storage IAM Permission
# --------------------------------------------------

resource "google_storage_bucket_iam_member" "public_access" {

  count = var.make_bucket_public ? 1 : 0

  bucket = google_storage_bucket.cdn_bucket.name

  role = "roles/storage.objectViewer"

  member = "allUsers"
}

# --------------------------------------------------
# Cloud CDN Backend Bucket
# --------------------------------------------------

resource "google_compute_backend_bucket" "cdn_backend" {

  project = var.project_id

  name = var.backend_bucket_name

  description = var.backend_bucket_description

  bucket_name = google_storage_bucket.cdn_bucket.name

  enable_cdn = var.enable_cdn

  compression_mode = var.compression_mode

  custom_response_headers = var.custom_response_headers

  edge_security_policy = var.edge_security_policy

  cdn_policy {

    cache_mode = var.cache_mode

    default_ttl = var.default_ttl

    max_ttl = var.max_ttl

    client_ttl = var.client_ttl

    negative_caching = var.negative_caching

    serve_while_stale = var.serve_while_stale

    signed_url_cache_max_age_sec = var.signed_url_cache_max_age_sec

    request_coalescing = var.request_coalescing

    dynamic "negative_caching_policy" {

      for_each = var.negative_caching_policy

      content {
        code = negative_caching_policy.value.code

        ttl = negative_caching_policy.value.ttl
      }
    }

    dynamic "cache_key_policy" {

      for_each = var.cache_key_policy == null ? [] : [var.cache_key_policy]

      content {

        query_string_whitelist = cache_key_policy.value.query_string_whitelist

        include_http_headers = cache_key_policy.value.include_http_headers
      }
    }

    dynamic "bypass_cache_on_request_headers" {

      for_each = var.bypass_cache_on_request_headers

      content {

        header_name = bypass_cache_on_request_headers.value
      }
    }
  }

  depends_on = [
    google_storage_bucket.cdn_bucket,
    google_storage_bucket_iam_member.public_access
  ]
}

# --------------------------------------------------
# Global URL Map
# --------------------------------------------------

resource "google_compute_url_map" "cdn_url_map" {

  project = var.project_id

  name = var.url_map_name

  description = var.url_map_description

  default_service = google_compute_backend_bucket.cdn_backend.id
}

# --------------------------------------------------
# Global Static IP Address
# --------------------------------------------------

resource "google_compute_global_address" "cdn_ip" {

  project = var.project_id

  name = var.global_ip_name

  ip_version = var.ip_version

  address_type = "EXTERNAL"
}

# --------------------------------------------------
# HTTP Proxy
# --------------------------------------------------

resource "google_compute_target_http_proxy" "cdn_http_proxy" {

  count = var.enable_http ? 1 : 0

  project = var.project_id

  name = var.http_proxy_name

  url_map = google_compute_url_map.cdn_url_map.id
}

# --------------------------------------------------
# HTTP Global Forwarding Rule
# --------------------------------------------------

resource "google_compute_global_forwarding_rule" "cdn_http_forwarding" {

  count = var.enable_http ? 1 : 0

  project = var.project_id

  name = var.http_forwarding_rule_name

  ip_protocol = "TCP"

  load_balancing_scheme = var.load_balancing_scheme

  port_range = "80"

  target = google_compute_target_http_proxy.cdn_http_proxy[0].id

  ip_address = google_compute_global_address.cdn_ip.address

  network_tier = var.network_tier
}

# --------------------------------------------------
# Google Managed SSL Certificate
# --------------------------------------------------

resource "google_compute_managed_ssl_certificate" "cdn_ssl_certificate" {

  count = var.enable_https ? 1 : 0

  project = var.project_id

  name = var.ssl_certificate_name

  managed {

    domains = var.domain_names
  }
}

# --------------------------------------------------
# HTTPS Proxy
# --------------------------------------------------

resource "google_compute_target_https_proxy" "cdn_https_proxy" {

  count = var.enable_https ? 1 : 0

  project = var.project_id

  name = var.https_proxy_name

  url_map = google_compute_url_map.cdn_url_map.id

  ssl_certificates = [
    google_compute_managed_ssl_certificate.cdn_ssl_certificate[0].id
  ]
}

# --------------------------------------------------
# HTTPS Global Forwarding Rule
# --------------------------------------------------

resource "google_compute_global_forwarding_rule" "cdn_https_forwarding" {

  count = var.enable_https ? 1 : 0

  project = var.project_id

  name = var.https_forwarding_rule_name

  ip_protocol = "TCP"

  load_balancing_scheme = var.load_balancing_scheme

  port_range = "443"

  target = google_compute_target_https_proxy.cdn_https_proxy[0].id

  ip_address = google_compute_global_address.cdn_ip.address

  network_tier = var.network_tier
}
